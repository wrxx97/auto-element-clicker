{
  "manifest_version": 3,
  "name": "Selector Clicker",
  "version": "1.0.0",
  "description": "Detect and click page elements that match your CSS selectors.",
  "permissions": ["storage", "tabs"],
  "action": {
    "default_title": "Selector Clicker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
